# External PostgreSQL (new VPS DB or managed DB)
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=autoparts_erp
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change_me_strong_password

# Redis
REDIS_PASSWORD=change_me_redis_password

# JWT (base64 encoded RSA keys)
JWT_PRIVATE_KEY=base64_encoded_rsa_private_key_pem
JWT_PUBLIC_KEY=base64_encoded_rsa_public_key_pem

# CORS
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Seed admin user (created once on first boot; the app will refuse to start
# in Production without a real password here — see scripts/deploy-vps.sh,
# which auto-generates one if left as a placeholder)
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_strong_password

# ERPNext accounting integration (optional — leave ERPNEXT_ENABLED=false, or omit entirely,
# to keep using NullErpNextClient). BaseUrl must be reachable from inside the api container —
# use host.docker.internal:<port> for an ERPNext instance running directly on the VPS host.
ERPNEXT_ENABLED=false
ERPNEXT_BASE_URL=http://host.docker.internal:8080
ERPNEXT_API_KEY=change_me_erpnext_api_key
ERPNEXT_API_SECRET=change_me_erpnext_api_secret
