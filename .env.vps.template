# External PostgreSQL (new VPS DB or managed DB)
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=autoparts_erp
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change_me_strong_password

# Database backups (scripts/backup-db.sh, scheduled by deploy-vps.sh: daily 02:30, restore check Sundays 04:15)
BACKUP_DIR=/var/backups/autoparts-erp
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
# Strongly recommended: a second machine reachable with an SSH key (rsync). Empty = backups stay on this server only.
# Example: backup@203.0.113.10:/srv/backups/autoparts-erp
BACKUP_REMOTE=

# Redis
REDIS_PASSWORD=change_me_redis_password

# JWT (base64 encoded RSA keys)
JWT_PRIVATE_KEY=base64_encoded_rsa_private_key_pem
JWT_PUBLIC_KEY=base64_encoded_rsa_public_key_pem

# CORS
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Seed admin user (created once on first boot; the app will refuse to start
# in Production without a real password here — see scripts/deploy-vps.sh,
# which auto-generates one if left as a placeholder)
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_strong_password

# ERPNext accounting integration (optional — leave ERPNEXT_ENABLED=false, or omit entirely,
# to keep using NullErpNextClient). BaseUrl must be reachable from inside the api container —
# use host.docker.internal:<port> for an ERPNext instance running directly on the VPS host.
ERPNEXT_ENABLED=false
ERPNEXT_BASE_URL=http://host.docker.internal:8080
ERPNEXT_API_KEY=change_me_erpnext_api_key
ERPNEXT_API_SECRET=change_me_erpnext_api_secret

# WhatsApp assistant (read-only questions from linked phone numbers). See SETUP_HARDENING.md "WhatsApp assistant".
WHATSAPP_ENABLED=false
# Generated by deploy-vps.sh when left empty; shared by the api and the gateway only.
ASSISTANT_GATEWAY_SECRET=
# Language model for understanding the question (only the message text is sent; no ERP data). Empty key = keyword rules only.
# Get a key at console.groq.com and paste it here ON THE SERVER only — never in chat, e-mail or git.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Maker-checker: false (default) = a second person must approve every governed action (post invoice, stop-ship, ...).
# Set true ONLY while a single operator runs the system, then create a second approver user and set it back to false.
GOVERNANCE_ALLOW_SELF_APPROVAL=false
